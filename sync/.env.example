# ── Hetzner / Servidor ──────────────────────────────────────────────────────
# IP ou domínio do servidor (ex: sync.seudominio.com)
N8N_HOST=sync.seudominio.com

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=n8n
POSTGRES_PASSWORD=senha_segura_aqui
POSTGRES_DB=n8n

# ── n8n ──────────────────────────────────────────────────────────────────────
# Chave de 32+ chars para criptografar credenciais salvas no n8n
# Gere com: openssl rand -hex 32
N8N_ENCRYPTION_KEY=troque_por_string_aleatoria_de_32_caracteres

# Login da interface web do n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=senha_da_interface

# ── Notion ────────────────────────────────────────────────────────────────────
# Token da Integration interna do Notion (Settings → Integrations)
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID do banco de dados raiz que será sincronizado
# (URL da página: notion.so/workspace/<DATABASE_ID>?v=...)
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Obsidian Local REST API ───────────────────────────────────────────────────
# Instale o plugin "Local REST API" no Obsidian (por coddingtonbear)
# O servidor escuta na máquina onde o Obsidian está aberto.
# Se o Obsidian ficar na mesma VM: http://localhost:27123
# Se ficar no seu computador local: seu IP local ou via túnel
OBSIDIAN_BASE_URL=http://localhost:27123
OBSIDIAN_API_KEY=sua_api_key_do_obsidian_local_rest

# Pasta do vault onde as notas do Notion serão escritas
OBSIDIAN_VAULT_FOLDER=Notion Sync

# ── Notion — IDs das bases de dados específicas ───────────────────────────────
# DB · Jurisprudência (STF, STJ, TSE, Corte IDH)
# URL da view: notion.so/...?v=... → copiar o ID antes do ?
NOTION_JURIS_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DB · Alterações Legislativas (Planalto, CNMP)
NOTION_LEGISLACAO_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DB · Execuções de Automação (log de cada execução do n8n)
NOTION_EXECUCOES_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Site / Vercel ─────────────────────────────────────────────────────────────
# Deploy Hook do Vercel para o site cockpit-mpsp / jurismp.xyz
# Crie em: vercel.com → projeto → Settings → Git → Deploy Hooks
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/xxxxxxxx/yyyyyyyy

# Repo GitHub onde o site vive (para push do notion-content.json)
# O push aciona o auto-deploy do Vercel automaticamente
GITHUB_REPO_OWNER=ricardodelemosadv
GITHUB_REPO_NAME=cockpit-mpsp
# Token com escopo "repo" (Contents: read/write)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Notificações Telegram ─────────────────────────────────────────────────────
# Bot criado via @BotFather; adicione ao seu canal/grupo e use o chat_id
TELEGRAM_BOT_TOKEN=0000000000:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# ── Sincronização ─────────────────────────────────────────────────────────────
# Intervalo do cron de Notion → Obsidian (padrão: a cada 15 min)
SYNC_CRON=*/15 * * * *

# Quantas páginas buscar por ciclo (max 100)
SYNC_PAGE_SIZE=50
