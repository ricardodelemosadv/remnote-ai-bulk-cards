# Configure estes valores como variáveis secretas no projeto da Vercel.
OPENAI_API_KEY=
# Gere pelo menos 32 bytes aleatórios (43+ caracteres em Base64), use apenas na sua
# instalação e guarde-o também na configuração local do plugin. Nunca o embuta no código público.
REMNOTE_BRIDGE_TOKEN=

# Opcional: modelo definido pelo servidor (nunca pelo plugin cliente).
OPENAI_MODEL=gpt-5.4-mini

# Opcional: origens HTTPS adicionais, separadas por vírgula.
# Os subdomínios HTTPS de remnote.com e os WebViews móveis do RemNote já são aceitos.
REMNOTE_ALLOWED_ORIGINS=

# Opcional: quota complementar por token em cada janela de 10 minutos (padrão: 20; máximo: 60).
# Como funções serverless têm várias instâncias, configure também um teto de gastos no projeto OpenAI.
REMNOTE_RATE_LIMIT_PER_10_MINUTES=20
